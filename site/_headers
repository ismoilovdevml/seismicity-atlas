# Cloudflare Pages response headers (ignored by GitHub Pages, the mirror).
# Cloudflare joins the values of a header set by several matching rules with commas, so a narrower rule first
# detaches the wider rule's Cache-Control ("! Cache-Control") before setting its own.

# Versioned third-party files and fonts never change at the same path: cache for a year.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Code and style sheets are not content-hashed and the ES modules import each other: a module cached from one release
# next to one from the next release can break the page, so the browser revalidates them on every load (a 304 when
# unchanged).
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Data files change with a release (about monthly) and are not content-hashed: an hour fresh, then served from the
# cache while revalidated in the background for a day.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# The manifest names the release and the file sizes; the monitor files are refreshed every day.
/data/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
/data/monitor/*
  ! Cache-Control
  Cache-Control: public, max-age=300, stale-while-revalidate=600

# Security headers for every response. The CSP lists what the site loads: its own files, the inline start-up script
# of index.html (by hash; tests/e2e/test_headers.py checks the hash), inline style attributes (set by the scripts and
# the static Learn pages), blob: workers and URLs (MapLibre, the event worker, CSV downloads), data: images, and the
# only outside source, the AWS Terrain Tiles of the optional 3D terrain.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/zQsfeCmUn/gTKfNviBKYXJhWsAi5/Xe+/fqDY+Q3Gw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: https://s3.amazonaws.com; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
